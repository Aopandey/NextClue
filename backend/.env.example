# Copy to backend/.env (gitignored). Local values come from `npx supabase status`.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# Recorded in every run and part of the cache key. Blank uses GEMINI_MODEL in ai/.env.
# An explicit MODEL_NAME overrides GEMINI_MODEL for both the request and metadata.
MODEL_NAME=
PROMPT_VERSION=extract-v3+handoff-v4

ANALYSIS_TIMEOUT_SECONDS=90
CORS_ORIGINS=http://localhost:3000
