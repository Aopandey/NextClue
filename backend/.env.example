# Copy to backend/.env (gitignored). Local values come from `npx supabase status`.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# Recorded in every run and part of the cache key.
MODEL_NAME=not-configured
PROMPT_VERSION=extract-v1+synth-v1

ANALYSIS_TIMEOUT_SECONDS=90
CORS_ORIGINS=http://localhost:3000
