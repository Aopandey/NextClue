# Keep the real key in ai/.env, which Git ignores.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=45

# Evidence: "cached" (default) uses every verified registered source.
# "pubmed" lets a bounded PubMed query rank registered sources only; runs are
# labeled live only when that query succeeded. Optional NCBI contact/key.
EVIDENCE_RETRIEVAL=cached
PUBMED_TIMEOUT_SECONDS=10
NCBI_EMAIL=
NCBI_API_KEY=
