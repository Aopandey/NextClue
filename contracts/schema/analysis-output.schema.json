{
  "$defs": {
    "Claim": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "pattern": "^clm-[a-z0-9-]+$",
          "title": "Claim Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "record_refs": {
          "items": {
            "$ref": "#/$defs/RecordRef"
          },
          "minItems": 1,
          "title": "Record Refs",
          "type": "array"
        },
        "source_refs": {
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "minItems": 1,
          "title": "Source Refs",
          "type": "array"
        }
      },
      "required": [
        "claim_id",
        "text",
        "record_refs",
        "source_refs"
      ],
      "title": "Claim",
      "type": "object"
    },
    "ClinicianQuestion": {
      "additionalProperties": false,
      "properties": {
        "question_id": {
          "pattern": "^q-[a-z0-9-]+$",
          "title": "Question Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "missing_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Missing Ids",
          "type": "array"
        }
      },
      "required": [
        "question_id",
        "text"
      ],
      "title": "ClinicianQuestion",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "finding_id": {
          "pattern": "^fnd-[a-z0-9-]+$",
          "title": "Finding Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "kind": {
          "enum": [
            "symptom",
            "sign",
            "lab_result",
            "imaging",
            "pathology",
            "diagnosis",
            "family_history"
          ],
          "title": "Kind",
          "type": "string"
        },
        "assertion": {
          "enum": [
            "present",
            "absent",
            "uncertain"
          ],
          "title": "Assertion",
          "type": "string"
        },
        "date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date"
        },
        "specialty": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Specialty"
        },
        "record_refs": {
          "items": {
            "$ref": "#/$defs/RecordRef"
          },
          "minItems": 1,
          "title": "Record Refs",
          "type": "array"
        },
        "hpo_id": {
          "anyOf": [
            {
              "pattern": "^HP:\\d{7}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hpo Id"
        }
      },
      "required": [
        "finding_id",
        "label",
        "kind",
        "assertion",
        "record_refs"
      ],
      "title": "Finding",
      "type": "object"
    },
    "Hypothesis": {
      "additionalProperties": false,
      "properties": {
        "hypothesis_id": {
          "pattern": "^hyp-[a-z0-9-]+$",
          "title": "Hypothesis Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "is_rare_disease": {
          "title": "Is Rare Disease",
          "type": "boolean"
        },
        "status": {
          "enum": [
            "open",
            "less_supported",
            "excluded"
          ],
          "title": "Status",
          "type": "string"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "supporting_finding_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Supporting Finding Ids",
          "type": "array"
        },
        "supporting_claim_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Supporting Claim Ids",
          "type": "array"
        },
        "contradicting_claim_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Contradicting Claim Ids",
          "type": "array"
        }
      },
      "required": [
        "hypothesis_id",
        "name",
        "is_rare_disease",
        "status",
        "summary"
      ],
      "title": "Hypothesis",
      "type": "object"
    },
    "MissingEvidence": {
      "additionalProperties": false,
      "properties": {
        "missing_id": {
          "pattern": "^mis-[a-z0-9-]+$",
          "title": "Missing Id",
          "type": "string"
        },
        "priority": {
          "description": "1 = investigate first",
          "minimum": 1,
          "title": "Priority",
          "type": "integer"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "why_it_matters": {
          "title": "Why It Matters",
          "type": "string"
        },
        "check_existing_first": {
          "title": "Check Existing First",
          "type": "boolean"
        },
        "existing_record_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RecordRef"
          },
          "title": "Existing Record Refs",
          "type": "array"
        },
        "claim_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Claim Ids",
          "type": "array"
        },
        "hypothesis_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Hypothesis Ids",
          "type": "array"
        },
        "possible_outcomes": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PossibleOutcome"
          },
          "title": "Possible Outcomes",
          "type": "array"
        }
      },
      "required": [
        "missing_id",
        "priority",
        "description",
        "why_it_matters",
        "check_existing_first",
        "claim_ids"
      ],
      "title": "MissingEvidence",
      "type": "object"
    },
    "PossibleOutcome": {
      "additionalProperties": false,
      "properties": {
        "outcome": {
          "title": "Outcome",
          "type": "string"
        },
        "implication": {
          "title": "Implication",
          "type": "string"
        }
      },
      "required": [
        "outcome",
        "implication"
      ],
      "title": "PossibleOutcome",
      "type": "object"
    },
    "PriorResultReview": {
      "additionalProperties": false,
      "properties": {
        "prior_result_id": {
          "pattern": "^pri-[a-z0-9-]+$",
          "title": "Prior Result Id",
          "type": "string"
        },
        "test_name": {
          "title": "Test Name",
          "type": "string"
        },
        "record_refs": {
          "items": {
            "$ref": "#/$defs/RecordRef"
          },
          "minItems": 1,
          "title": "Record Refs",
          "type": "array"
        },
        "result_summary": {
          "title": "Result Summary",
          "type": "string"
        },
        "interpretation_at_the_time": {
          "title": "Interpretation At The Time",
          "type": "string"
        },
        "what_it_established": {
          "title": "What It Established",
          "type": "string"
        },
        "limitation_claim_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Limitation Claim Ids",
          "type": "array"
        },
        "hypothesis_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Hypothesis Ids",
          "type": "array"
        }
      },
      "required": [
        "prior_result_id",
        "test_name",
        "record_refs",
        "result_summary",
        "interpretation_at_the_time",
        "what_it_established",
        "limitation_claim_ids"
      ],
      "title": "PriorResultReview",
      "type": "object"
    },
    "RecordRef": {
      "additionalProperties": false,
      "properties": {
        "record_id": {
          "pattern": "^rec-[a-z0-9-]+$",
          "title": "Record Id",
          "type": "string"
        },
        "excerpt": {
          "description": "Exact quote from the document text",
          "title": "Excerpt",
          "type": "string"
        }
      },
      "required": [
        "record_id",
        "excerpt"
      ],
      "title": "RecordRef",
      "type": "object"
    },
    "SourceRef": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "pattern": "^src-[a-z0-9-]+$",
          "title": "Source Id",
          "type": "string"
        },
        "excerpt_id": {
          "pattern": "^exc-[a-z0-9-]+$",
          "title": "Excerpt Id",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "excerpt_id"
      ],
      "title": "SourceRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "findings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Findings",
      "type": "array"
    },
    "claims": {
      "items": {
        "$ref": "#/$defs/Claim"
      },
      "title": "Claims",
      "type": "array"
    },
    "prior_results": {
      "items": {
        "$ref": "#/$defs/PriorResultReview"
      },
      "title": "Prior Results",
      "type": "array"
    },
    "hypotheses": {
      "items": {
        "$ref": "#/$defs/Hypothesis"
      },
      "maxItems": 3,
      "minItems": 1,
      "title": "Hypotheses",
      "type": "array"
    },
    "missing_evidence": {
      "items": {
        "$ref": "#/$defs/MissingEvidence"
      },
      "title": "Missing Evidence",
      "type": "array"
    },
    "clinician_questions": {
      "items": {
        "$ref": "#/$defs/ClinicianQuestion"
      },
      "title": "Clinician Questions",
      "type": "array"
    }
  },
  "required": [
    "findings",
    "claims",
    "prior_results",
    "hypotheses",
    "missing_evidence",
    "clinician_questions"
  ],
  "title": "AnalysisOutput",
  "type": "object"
}
